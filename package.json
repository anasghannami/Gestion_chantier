{
  "name": "gestion-chantier-desktop",
  "version": "1.0.0",
  "description": "Application de bureau pour la Gestion des Chantiers BTP",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build:client": "npm --prefix client run build",
    "start": "electron .",
    "dist": "npm run build:client && npx electron-builder --win --dir"
  },
  "build": {
    "appId": "com.btp.gestionchantier",
    "productName": "Gestion Chantier",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "build/**/*",
      "client/dist/**/*",
      "server/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestion Chantier BTP"
    }
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  }
}
