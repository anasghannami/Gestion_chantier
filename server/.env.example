# Base de données embarquée (par défaut) — aucune installation requise,
# l'app fonctionne hors ligne. Laisser DB_STORAGE vide en dev : le fichier
# est créé automatiquement dans server/data/database.sqlite
DB_DIALECT=sqlite
DB_STORAGE=

# --- Alternative PostgreSQL (déploiement serveur/web partagé) ---
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASS=your_password_here
# DB_NAME=gestion_chantier
# DB_PORT=5432

JWT_SECRET=your_jwt_secret_here
PORT=5000

# Configuration Envoi Email (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
